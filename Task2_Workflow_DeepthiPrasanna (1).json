      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        100
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "GET",
        "url": "https://hacker-news.firebaseio.com/v0/topstories.json",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "n4",
      "name": "Take Top 5",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Normalize the HackerNews response (array of IDs) and keep only the top 5\nconst ids = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  if (Array.isArray(j)) ids.push(...j);\n  else if (typeof j === 'number') ids.push(j);\n  else if (j && Array.isArray(j.data)) ids.push(...j.data);\n  else if (j && typeof j.data === 'number') ids.push(j.data);\n}\nreturn ids.slice(0, 5).map(id => ({ json: { id } }));"
      }
    },
    {
      "id": "n5",
      "name": "Get Story Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        0
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "GET",
        "url": "=https://hacker-news.firebaseio.com/v0/item/{{ $json.id }}.json",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "n6",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        -100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Reshape: keep valid stories, sort by score (highest first), build one digest text\nconst stories = $input.all()\n  .map(i => i.json)\n  .filter(s => s && s.title && typeof s.score === 'number')\n  .sort((a, b) => b.score - a.score);\n\nif (stories.length === 0) {\n  throw new Error('No valid stories returned by the HackerNews item API');\n}\n\nconst lines = stories.map((s, i) => {\n  const link = s.url || ('https://news.ycombinator.com/item?id=' + s.id);\n  return (i + 1) + '. ' + s.title + ' (' + s.score + ' points, ' + (s.descendants || 0) + ' comments)\\n' + link;\n});\n\nreturn [{ json: {\n  topScore: stories[0].score,\n  topTitle: stories[0].title,\n  digest: lines.join('\\n\\n')\n} }];"
      }
    },
    {
      "id": "n7",
      "name": "Top Score > 100?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1300,
        -100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.topScore }}",
              "rightValue": 100,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
